{
  "name": "beeftv-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run prepare:content && next build",
    "dev": "bun run prepare:content && next dev --hostname 127.0.0.1 --port 35407",
    "start": "bun run preview",
    "preview": "serve out --listen tcp://127.0.0.1:35407",
    "types:check": "bun run prepare:content && next typegen && tsc --noEmit",
    "prepare:content": "node scripts/prepare-content.mjs",
    "test": "bun test scripts"
  },
  "dependencies": {
    "fumadocs-core": "16.15.8",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.8",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "postcss": "8.5.26",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  }
}