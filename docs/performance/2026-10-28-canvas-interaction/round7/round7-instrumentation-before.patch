+});
+
+button("perf-open", "#0ff", () => {
+    location.hash = `#/canvas/${(window as any).__perfCanvasId}`;
+});
+
+button("perf-hover", "#0ff", () => {
+    // 悬停用真实鼠标，这里只报出若干可见卡片中心，方便逐个移过去。
+    const centers = [...document.querySelectorAll<HTMLElement>("[data-node-id]")].map((element) => {
